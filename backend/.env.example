# Copy to backend/.env for local overrides. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./finance.db
# Local Postgres from docker-compose:
# DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5432/finance
AUTO_CREATE_TABLES=true
AUTH_MODE=dev
FIREBASE_PROJECT_ID=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AI onboarding chat. Get a key at https://aistudio.google.com/apikey — never commit it.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_ENDPOINT=auto   # ai_studio | vertex | auto
